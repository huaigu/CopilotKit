# Server-side model configuration. No key is sent to the browser.
PI_PROVIDER=openai
PI_MODEL=gpt-5.2
PI_API_KEY=
# Optional OpenAI-compatible endpoint, with /v1 suffix where required.
# PI_BASE_URL=https://api.example.com/v1
# Optional absolute directory for durable sessions.
# PI_SESSION_DIR=/absolute/path/to/pi-sessions

# Explicit deterministic verification mode. Never enabled by default.
PI_TEST_MODE=false
COPILOTKIT_TELEMETRY_DISABLED=true
NEXT_TELEMETRY_DISABLED=1
